// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`PdfRenderer.toHtml produces a deterministic HTML document for the 13-card fixture 1`] = `
"<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>Hits dos Anos 80</title>
<meta name="author" content="Tocarta" />
<meta name="subject" content="Music year-guess card deck" />
<meta name="keywords" content="tocarta,music,cards" />
<style>
@font-face {
  font-family: 'Fraunces';
  font-weight: 600;
  font-style: normal;
  src: url('https://fonts.gstatic.com/s/fraunces/v34/6NUh8FyLNQOQZAnv9bYM3KSU.woff2') format('woff2');
}
@font-face {
  font-family: 'Nunito';
  font-weight: 400;
  font-style: normal;
  src: url('https://fonts.gstatic.com/s/nunito/v26/XRXV3I6Li01BKofINeaB.woff2') format('woff2');
}
@font-face {
  font-family: 'Nunito';
  font-weight: 700;
  font-style: normal;
  src: url('https://fonts.gstatic.com/s/nunito/v26/XRXW3I6Li01BKofA6sKUYevN.woff2') format('woff2');
}
@page {
  size: 210mm 297mm;
  margin: 0;
}
* { box-sizing: border-box; }
html, body {
  margin: 0;
  padding: 0;
  background: #ffffff;
  color: #0d1422;
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
}
.page {
  position: relative;
  width: 210mm;
  height: 297mm;
  overflow: hidden;
  page-break-after: always;
}
.page:last-child { page-break-after: auto; }
.front-page { background: #ffffff; }
.back-page { background: #ffffff; }
.bleed {
  position: absolute;
}
.card {
  position: absolute;
  width: 60mm;
  height: 60mm;
  overflow: hidden;
}
.card.front {
  background: #ffffff;
}
.card.front .qr {
  position: absolute;
  left: 12mm;
  top: 8mm;
  width: 36mm;
  height: 36mm;
}
.card.front .wordmark {
  position: absolute;
  left: 0;
  right: 0;
  top: 44.5mm;
  text-align: center;
  font-family: 'Fraunces', serif;
  font-weight: 600;
  font-size: 5mm;
  color: #0d1422;
  text-transform: lowercase;
  letter-spacing: 0;
  line-height: 1;
}
.card.back {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4mm;
}
.back-content {
  width: 100%;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1mm;
}
.year {
  font-family: 'Fraunces', serif;
  font-weight: 600;
  font-size: 21mm;
  line-height: 1;
}
.artist {
  font-family: 'Nunito', sans-serif;
  font-weight: 700;
  font-size: 4mm;
  line-height: 1.15;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}
.title {
  font-family: 'Nunito', sans-serif;
  font-weight: 400;
  font-size: 3.5mm;
  line-height: 1.2;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}
.crop {
  position: absolute;
}
</style>
</head>
